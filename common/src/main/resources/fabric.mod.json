{
  "schemaVersion": 1,
  "id": "yet-another-minecraft-bingo-common",
  "name": "Yet Another Minecraft BINGO",
  "version": "$version",
  "environment": "*",
  "icon": "bingo/icon.png",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "me.jfenn.bingo.common.Bingo"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.jfenn.bingo.client.common.Main"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.20",
    "java": ">=17",
    "fabric-api": "*"
  },
  "contact": {
    "homepage": "https://minecraft.horrific.dev/bingo/",
    "sources": "https://gitlab.com/horrific-tweaks/bingo/",
    "issues": "https://gitlab.com/horrific-tweaks/bingo/-/issues/"
  },
  "authors": [
    "fennifith"
  ],
  "description": "Common cross-version functionality for the BINGO mod",
  "mixins": [
    "mixins.bingo-common.json"
  ],
  "accessWidener": "bingo.accesswidener",
  "custom": {
    "modmenu": {
      "parent": "yet-another-minecraft-bingo",
      "badges": ["library"],
      "links": {
        "Discord": "https://discord.horrific.dev"
      }
    }
  }
}
