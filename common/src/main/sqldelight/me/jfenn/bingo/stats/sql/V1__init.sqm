CREATE TABLE Game (
    id TEXT NOT NULL PRIMARY KEY,
    started_at TEXT NOT NULL,
    ended_at TEXT NOT NULL,
    minecraft_version TEXT NOT NULL,
    bingo_version TEXT NOT NULL
);

CREATE TABLE GameTeam (
    id TEXT NOT NULL PRIMARY KEY,
    game TEXT NOT NULL REFERENCES Game(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    is_winner INTEGER NOT NULL
);

CREATE TABLE GamePlayer (
    team TEXT NOT NULL REFERENCES GameTeam(id) ON DELETE CASCADE,
    minecraft_id TEXT NOT NULL,
    minecraft_name TEXT NOT NULL,
    captured_items INTEGER NOT NULL,
    PRIMARY KEY (team, minecraft_id)
);
