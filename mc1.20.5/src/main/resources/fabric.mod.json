{
  "schemaVersion": 1,
  "id": "yet-another-minecraft-bingo",
  "name": "Yet Another Minecraft BINGO",
  "version": "$version",
  "environment": "*",
  "icon": "bingo/icon.png",
  "entrypoints": {
    "server": [
      {
        "adapter": "kotlin",
        "value": "me.jfenn.bingo.server.Main"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.jfenn.bingo.client.Main"
      }
    ],
    "modmenu": [
      "me.jfenn.bingo.client.entrypoint.ModMenuEntrypoint"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.20.5-beta.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "contact": {
    "homepage": "https://minecraft.horrific.dev/bingo/",
    "sources": "https://gitlab.com/horrific-tweaks/bingo/",
    "issues": "https://gitlab.com/horrific-tweaks/bingo/-/issues/"
  },
  "authors": [
    "fennifith"
  ],
  "description": "A multiplayer BINGO item hunt mod + lobby",
  "mixins": [],
  "accessWidener": "bingo-impl.accesswidener",
  "custom": {
    "modmenu": {
      "links": {
        "Discord": "https://discord.horrific.dev"
      }
    }
